{
  "name": "filmisbest",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "prisma:dbpush": "prisma db push",
    "check": "greenly",
    "react-doctor": "react-doctor --verbose",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typegen": "sanity schema extract --enforce-required-fields  --path=./src/sanity/extract.json && sanity typegen generate && rm ./src/sanity/extract.json",
    "install:skills": "pnpx skills@latest experimental_install",
    "install:heroui_docs": "pnpx heroui-cli@latest agents-md --react --output AGENTS.md",
    "sync:omdb": "sanity exec scripts/sync-omdb.ts --with-user-token",
    "sync:sequels": "sanity exec scripts/sync-sequels.ts --with-user-token",
    "remove-assets": "sanity exec scripts/remove-unused-assets.ts --with-user-token",
    "remove-assets:preview": "sanity exec scripts/preview-unused-assets.ts --with-user-token",
    "bootstrap": "pnpm install && pnpm install:skills && pnpm install:heroui_docs"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.80",
    "@better-auth/prisma-adapter": "1.7.1",
    "@heroui/button": "2.2.32",
    "@heroui/dropdown": "2.3.32",
    "@heroui/input": "2.4.33",
    "@heroui/modal": "2.2.29",
    "@heroui/pagination": "2.2.27",
    "@heroui/select": "2.4.33",
    "@heroui/system": "2.4.28",
    "@heroui/theme": "2.4.26",
    "@lottiefiles/dotlottie-react": "0.19.15",
    "@modelcontextprotocol/server": "2.0.0",
    "@next/third-parties": "16.3.2",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@prisma/adapter-neon": "7.9.1",
    "@prisma/client": "7.9.1",
    "@sanity/client": "8.2.0",
    "@sanity/icons": "5.2.1",
    "@sanity/image-url": "2.1.1",
    "@sanity/ui": "4.0.6",
    "@sanity/vision": "6.10.1",
    "ai": "7.0.77",
    "better-auth": "1.7.1",
    "clsx": "2.1.1",
    "fuse.js": "7.5.0",
    "mcp-handler": "2.1.1",
    "next": "16.3.2",
    "next-intl": "4.13.7",
    "next-sanity": "13.3.3",
    "nuqs": "2.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "sanity": "6.10.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "styled-components": "6.5.3",
    "tailwind-merge": "3.6.0",
    "typescript": "7.0.2",
    "use-debounce": "10.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "17.4.2",
    "greenly": "1.1.6",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "postcss-load-config": "6.0.1",
    "prisma": "7.9.1",
    "react-doctor": "0.9.12",
    "tailwindcss": "4.3.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
