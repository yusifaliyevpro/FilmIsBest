{
  "name": "filmisbest",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "prisma:dbpush": "prisma db push",
    "check": "greenly",
    "react-doctor": "react-doctor --verbose",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typegen": "sanity schema extract --enforce-required-fields  --path=./src/sanity/extract.json && sanity typegen generate && rm ./src/sanity/extract.json",
    "install:skills": "pnpx skills@latest experimental_install",
    "install:heroui_docs": "pnpx heroui-cli@latest agents-md --react --output AGENTS.md",
    "sync:omdb": "sanity exec scripts/sync-omdb.ts --with-user-token",
    "sync:sequels": "sanity exec scripts/sync-sequels.ts --with-user-token",
    "remove-assets": "sanity exec scripts/remove-unused-assets.ts --with-user-token",
    "remove-assets:preview": "sanity exec scripts/preview-unused-assets.ts --with-user-token",
    "bootstrap": "pnpm install && pnpm install:skills && pnpm install:heroui_docs"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.170",
    "@better-auth/passkey": "1.7.19",
    "@better-auth/prisma-adapter": "1.7.19",
    "@heroui/button": "2.2.32",
    "@heroui/modal": "2.2.29",
    "@heroui/pagination": "2.2.27",
    "@heroui/select": "2.4.33",
    "@heroui/system": "2.4.28",
    "@heroui/theme": "2.4.26",
    "@lottiefiles/dotlottie-react": "0.21.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@next/third-parties": "16.4.6",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@prisma/adapter-neon": "7.9.1",
    "@prisma/client": "7.9.1",
    "@sanity/client": "8.15.1",
    "@sanity/icons": "5.3.0",
    "@sanity/image-url": "2.1.1",
    "@sanity/ui": "4.4.10",
    "@sanity/vision": "6.22.0",
    "@vercel/speed-insights": "2.1.0",
    "ai": "7.0.166",
    "better-auth": "1.7.19",
    "cn": "0.5.2",
    "fuse.js": "7.5.0",
    "mcp-handler": "2.3.1",
    "next": "16.4.6",
    "next-intl": "4.14.9",
    "next-sanity": "13.4.0",
    "nuqs": "2.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "sanity": "6.22.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "styled-components": "6.6.0",
    "typescript": "7.0.2",
    "use-debounce": "10.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "18.0.10",
    "greenly": "1.2.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "postcss-load-config": "6.0.1",
    "prisma": "7.9.1",
    "react-doctor": "0.9.22",
    "tailwindcss": "4.3.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.15.0 <13",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12.15.0 <13"
  }
}
